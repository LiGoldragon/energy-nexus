Signal
[ crate:[ Emission Outcome ]
  signal_energy_nexus:[ Provider At ContractMismatch ] ] ; imports the emissions and the Energy vocabulary
[ Emit.Emission                                            ; one external call, through the translator
  TurnEnds ]                                               ; the Flow Nexus's turn ends at the place, held open
[ Emitted.Outcome                                          ; the call's own outcome
  TurnEndsObserved.Vector<TurnEnd>                         ; on open: the last turn end on each provider
  TurnEnded.TurnEnd                                        ; then each turn end as it comes, answering no input
  Down                                                     ; the turn ends closed: the translator's watch on the place is lost
  TurnEndsRefused.ContractMismatch ]                       ; Flow refused the subscription at its greeting, its contract not this one: no turn end comes until Flow's socket is placed again
[ TurnEnd.{ Provider At } ]                                ; a turn ended on a provider
