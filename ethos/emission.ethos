Emission
[ signal_energy_nexus:[ Reading ResetId Recipient Level Provider Reset ] ] ; imports the Energy vocabulary
[ CodexRateLimits                                          ; one external call per emission, the n-th outcome its own
  CodexConsumeReset
  ClaudeUsage
  Send
  SendFault ]
[ CodexRateLimitsObserved.Observation                      ; Codex's rate limits, read through its app-server
  CodexResetConsumed.Consumption                           ; one reset consumed, idempotently
  ClaudeUsageObserved.Observation                          ; Claude's usage, read with its credentials
  ReminderSent.Delivery                                    ; one reminder sent through the Flow Nexus client
  FaultSent.Delivery ]                                     ; one Session-spent fault sent through the Flow Nexus client
[ CodexRateLimits.{}                                       ; carries nothing, so that it bears Emittable
  ClaudeUsage.{}                                           ; carries nothing, so that it bears Emittable
  CodexConsumeReset.{ ResetId Idempotency.String }
  Send.{ Recipient Provider Level }
  SendFault.{ Recipient Provider }                         ; the provider's Session is spent out: a fault in the pace of work
  Observation.[ Observed.Reading Down.Failure ]            ; what the translator observed, or the provider down and how
  Failure.{ Cause Status.Option<HttpStatus> RetryAfter.Option<Seconds> } ; one failed reading: why, the answer's status, and when the provider said to come back
  Cause.[ Unconfigured                                     ; no program or credentials set
          CredentialsUnreadable                            ; the credentials file is missing, not JSON, or holds no token
          Unreached                                        ; the provider did not answer
          Refused                                          ; the provider answered with a status that is not a success
          AnswerUnreadable ]                               ; the provider answered and its answer holds no reading
  HttpStatus.Integer                                       ; the status of the provider's answer
  Seconds.Integer                                          ; the provider's retry-after, whole seconds from the answer
  Consumption.[ Reset NothingToReset NoCredit AlreadyRedeemed Down ] ; the reset-consumption outcomes
  Delivery.[ Sent Down ] ]                                 ; the reminder submitted, or not
